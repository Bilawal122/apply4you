# --- Supabase (web client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server / worker, service role bypasses RLS) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres direct (migrations via supabase db push) ---
DATABASE_URL=

# --- AI ---
GEMINI_API_KEY=

# --- Queue ---
REDIS_URL=redis://localhost:6379

# --- Worker ---
WORKER_CONCURRENCY=2
PLAYWRIGHT_HEADLESS=true

# --- Email notifications (worker, optional — no-ops until set) ---
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=Apply4You <notifications@apply4you.app>

# --- App ---
APP_URL=http://localhost:3000

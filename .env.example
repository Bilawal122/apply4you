# --- Supabase (web client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server / worker, service role bypasses RLS) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres direct (migrations via supabase db push) ---
DATABASE_URL=

# --- AI ---
GEMINI_API_KEY=

# --- Queue ---
REDIS_URL=redis://localhost:6379

# --- Worker ---
# NOTE: WORKER_CONCURRENCY is not read anywhere — each processor hardcodes its
# own concurrency in startWorker(). Kept for now so the deploy docs match, but
# changing it has no effect.
WORKER_CONCURRENCY=2
PLAYWRIGHT_HEADLESS=true

# --- Errors (worker) ---
# Read by apps/worker/src/index.ts; absent here until now. Sentry on the worker
# is a hard precondition of the first real submission (DECISIONS.md D3.8).
SENTRY_DSN=

# --- Email notifications (worker, optional — no-ops until set) ---
RESEND_API_KEY=
# Quoted: the angle brackets are shell redirection if this file is sourced.
NOTIFY_FROM_EMAIL="Apply4You <notifications@apply4you.app>"

# --- App ---
APP_URL=http://localhost:3000
